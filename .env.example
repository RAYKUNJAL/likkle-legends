# Likkle Legends local development env.
# Keep real secrets out of git. App Hosting secrets are referenced in apphosting.yaml.

NEXT_PUBLIC_APP_ID=likkle-legends
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=likkle-legends
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=likkle-legends.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=likkle-legends
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=likkle-legends.appspot.com

# Journey Stories. The compose service journey-worker claims journey_story_jobs
# and draws one page at a time. No external queue.
# Without GEMINI_API_KEY, or with JOURNEY_ART_HOLD=1, pictures stay local SVGs.
# Literal words need OPENROUTER_API_KEY or LLM_API_KEY; otherwise that mode fails closed.
# Do not put real tokens in git.
GEMINI_API_KEY=
# JOURNEY_ART_HOLD=
# OPENROUTER_API_KEY=
# LLM_API_KEY=
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# FAL.ai — for FLUX illustration generation (POST /api/tanty/illustrate)
FAL_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
# Public client id used by checkout buttons. Plan ids are PayPal billing plan ids, not secrets.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_DIGITAL=
NEXT_PUBLIC_PAYPAL_PLAN_DIGITAL_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_STARTER=
NEXT_PUBLIC_PAYPAL_PLAN_MAIL_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_LEGENDS=
NEXT_PUBLIC_PAYPAL_PLAN_PLUS_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_FAMILY=
NEXT_PUBLIC_PAYPAL_PLAN_FAMILY_YEARLY=
NEXT_PUBLIC_PLAN_FAMILY_YEARLY=
PAPERCLIP_GOVERNANCE_TOKEN=

# Existing Supabase values stay during the staged migration.
