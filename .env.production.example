# Likkle Legends — production environment (VPS / docker compose)
# Copy to .env.production and fill in real values. NEVER commit .env.production.

# ---- Site ----
NEXT_PUBLIC_APP_URL=https://www.likklelegends.com
SITE_DOMAIN=www.likklelegends.com
SITE_DOMAIN_ALT=likklelegends.com

# ---- Supabase (required — app will not start without the first two) ----
NEXT_PUBLIC_SUPABASE_URL=https://yvoyywnxaammsfwgjvkp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://yvoyywnxaammsfwgjvkp.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ----
# Buddy chat, admin content agents, and Journey Stories page pictures.
# journey-worker draws one Imagen image at a time when this key is set.
# Optional override: GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# JOURNEY_ART_HOLD=1 forces local SVG placeholders and skips image APIs.
GEMINI_API_KEY=
# Journey Stories words. Literal mode fails closed when both are empty.
OPENROUTER_API_KEY=
LLM_API_KEY=
# Content generator (Claude)
ANTHROPIC_API_KEY=
# Voice fallback (optional)
ELEVENLABS_API_KEY=

# ---- Payments (PayPal) ----
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
NEXT_PUBLIC_PAYPAL_PLAN_DIGITAL=
NEXT_PUBLIC_PAYPAL_PLAN_DIGITAL_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_STARTER=
NEXT_PUBLIC_PAYPAL_PLAN_MAIL_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_LEGENDS=
NEXT_PUBLIC_PAYPAL_PLAN_PLUS_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_FAMILY=
NEXT_PUBLIC_PAYPAL_PLAN_FAMILY_YEARLY=
NEXT_PUBLIC_PLAN_FAMILY_YEARLY=

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- SMS (optional, Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Scheduled jobs ----
# Any long random string; the cron container sends it as a Bearer token
# to /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Observability (optional) ----
SENTRY_DSN=
ELEVENLABS_STORY_VOICE_ID=RdKVaQgg8n1rUzICELn1
