rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/apps/likkle-legends/admins/$(request.auth.uid));
    }

    match /apps/{appId}/config/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/{appId}/config/private {
      allow read, write: if isAdmin();
    }

    match /apps/{appId}/users/{userId} {
      allow create, read, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /children/{childId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /apps/{appId}/entitlements/{subjectId} {
      allow read: if isOwner(subjectId) || isAdmin();
      allow write: if false;
    }

    match /apps/{appId}/content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/{appId}/generatedAssets/{assetId} {
      allow read: if resource.data.visibility == "public" || isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /apps/{appId}/jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "queued";
      allow read: if isAdmin() || resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/{appId}/payments/{eventId} {
      allow read, write: if false;
    }

    match /apps/{appId}/webhooks/{provider}/{eventId} {
      allow read, write: if false;
    }

    match /apps/{appId}/auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /apps/{appId}/paperclipEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /apps/{appId}/admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
